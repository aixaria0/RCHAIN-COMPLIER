{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aixaria0.github.io/causal-assurance/ecosystem-contract-v1.schema.json",
  "title": "Causal Assurance Ecosystem Contract v1",
  "type": "object",
  "required": [
    "schema",
    "runId",
    "subject",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "causal-assurance-ecosystem/v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "required": [
        "possibility",
        "observation",
        "workbench"
      ],
      "properties": {
        "possibility": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "producer": {
                  "const": "RCHAIN-COMPLIER"
                }
              }
            }
          ]
        },
        "observation": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "producer": {
                  "const": "rchain-sentinel"
                }
              }
            }
          ]
        },
        "workbench": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "producer": {
                  "const": "rlsenti"
                }
              }
            }
          ]
        },
        "attestation": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "producer": {
                  "const": "Sovereign-Lattice"
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "producer",
        "schema",
        "digest",
        "status"
      ],
      "properties": {
        "producer": {
          "enum": [
            "RCHAIN-COMPLIER",
            "rchain-sentinel",
            "rlsenti",
            "Sovereign-Lattice"
          ]
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_TESTED"
          ]
        },
        "bindsTo": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
