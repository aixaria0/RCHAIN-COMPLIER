{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:assurance:review-context:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "expectedPolicyDigest",
    "expectedTaskId",
    "expectedClaimId",
    "expectedPackageDigest"
  ],
  "properties": {
    "schema": {
      "const": "assurance-review-context/v1"
    },
    "expectedPolicyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expectedTaskId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expectedClaimId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expectedPackageDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
